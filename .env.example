# ============================================================
# CareerOS India — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to source control.
# ============================================================

# ----- Database (PostgreSQL via Supabase or Railway) -----
DATABASE_URL="postgresql://user:password@host:5432/careeros?schema=public"

# ----- Auth (next-auth v4) -----
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----- AI (Anthropic Claude) -----
ANTHROPIC_API_KEY=""

# ----- Embeddings (OpenAI) -----
OPENAI_API_KEY=""

# ----- Vector DB (Pinecone) -----
PINECONE_API_KEY=""
PINECONE_INDEX_HOST=""

# ----- AWS S3 (resume & tailored DOCX files — NOT a replacement for PostgreSQL) -----
# When all three are set, uploads go to S3 automatically. Jobs/users stay in Postgres.
# IAM user needs: s3:PutObject, s3:GetObject on the bucket (Block Public Access ON).
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
S3_BUCKET_NAME="your-bucket-name"
# RESUME_STORAGE="local"   # uncomment to force .uploads/ even when AWS is configured

# ----- Email (SendGrid) -----
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@careeros.in"
SENDGRID_VERIFICATION_TEMPLATE_ID=""
SENDGRID_OTP_TEMPLATE_ID=""
SENDGRID_WELCOME_TEMPLATE_ID=""

# ----- Redis (Upstash) -----
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ----- Jobs API (RapidAPI JSearch — Indeed, LinkedIn, Naukri, ZipRecruiter) -----
JSEARCH_API_KEY=""
JSEARCH_API_HOST="jsearch.p.rapidapi.com"

# ----- Adzuna India (free at https://developer.adzuna.com) -----
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# ----- Firebase (FCM push notifications) -----
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ----- Cron protection -----
CRON_SECRET="generate-a-random-string"

# ----- App -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_FIREBASE_CONFIG='{"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":""}'
