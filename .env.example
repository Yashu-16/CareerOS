# ============================================================
# CareerOS India — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to source control.
# ============================================================

# ----- Database (PostgreSQL via Supabase or Railway) -----
DATABASE_URL="postgresql://user:password@host:5432/careeros?schema=public"

# ----- Auth (next-auth v4) -----
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----- AI (Anthropic Claude) -----
ANTHROPIC_API_KEY=""

# ----- Embeddings (OpenAI) -----
OPENAI_API_KEY=""

# ----- Vector DB (Pinecone) -----
PINECONE_API_KEY=""
PINECONE_INDEX_HOST=""

# ----- AWS S3 (Mumbai region for India) -----
# Leave credentials empty for local dev — resumes are stored in .uploads/ instead.
# Set RESUME_STORAGE=local to force local storage even when AWS is configured.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
S3_BUCKET_NAME="careeros-resumes-india"
# RESUME_STORAGE="local"

# ----- Email (SendGrid) -----
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@careeros.in"
SENDGRID_VERIFICATION_TEMPLATE_ID=""
SENDGRID_OTP_TEMPLATE_ID=""
SENDGRID_WELCOME_TEMPLATE_ID=""

# ----- Redis (Upstash) -----
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ----- Jobs API (RapidAPI JSearch) -----
JSEARCH_API_KEY=""
JSEARCH_API_HOST="jsearch.p.rapidapi.com"

# ----- Firebase (FCM push notifications) -----
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ----- Cron protection -----
CRON_SECRET="generate-a-random-string"

# ----- App -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_FIREBASE_CONFIG='{"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":""}'
