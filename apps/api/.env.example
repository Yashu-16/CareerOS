# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://careeros:careeros@localhost:5432/careeros?schema=public"

# ── Auth (JWT — no third-party provider) ────────────────────────────────────
JWT_ACCESS_SECRET="change-this-to-a-long-random-string-in-production"
JWT_ACCESS_EXPIRY="15m"

# ── OpenAI (REQUIRED — resume parsing & tailoring will fail without this) ──
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# ── Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR="/app/uploads"

# ── App ──────────────────────────────────────────────────────────────────
PORT=4000
WEB_APP_URL="http://localhost:3000"
