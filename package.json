{
  "name": "careeros-india",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered career intelligence platform for Indian students and early-career professionals.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "dotenv -e .env.local -- prisma generate",
    "prisma:push": "dotenv -e .env.local -- prisma db push",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "prisma:studio": "dotenv -e .env.local -- prisma studio",
    "db:check": "node scripts/check-database.mjs",
    "db:seed-jobs": "dotenv -e .env.local -- node scripts/seed-jobs.mjs",
    "db:bootstrap": "dotenv -e .env.local -- node scripts/bootstrap-db.mjs",
    "sync:jobs": "dotenv -e .env.local -- npx tsx scripts/sync-jobs.ts",
    "sync:events": "dotenv -e .env.local -- npx tsx scripts/sync-events.ts",
    "sync:all": "dotenv -e .env.local -- npx tsx scripts/sync-all.ts",
    "test:email": "node scripts/test-email.mjs",
    "postinstall": "node scripts/prisma-generate.mjs"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^9.0.0",
    "@hookform/resolvers": "^3.9.1",
    "@pinecone-database/pinecone": "^4.0.0",
    "@prisma/client": "^6.1.0",
    "@sendgrid/mail": "^8.1.4",
    "@upstash/redis": "^1.34.3",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.3",
    "firebase": "^11.1.0",
    "firebase-admin": "^13.0.2",
    "framer-motion": "^11.15.0",
    "isomorphic-dompurify": "^2.19.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.8.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.11",
    "openai": "^4.77.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.5",
    "react-hook-form": "^7.54.2",
    "resend": "^6.14.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.17.10",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
